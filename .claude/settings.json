{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/git-precommit-privatedocs-guard.mjs"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "llm@nonoun-plugins": true,
    "harness@nonoun-plugins": true,
    "docs@nonoun-plugins": true,
    "teamwork@nonoun-plugins": true,
    "frontend@nonoun-plugins": true,
    "agent-protocols@nonoun-plugins": true,
    "design@nonoun-plugins": true,
    "authorkit@nonoun-plugins": true,
    "figma@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "nonoun-plugins": {
      "source": {
        "source": "github",
        "repo": "kimgranlund/claude-plugins"
      }
    }
  }
}
